generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL
  LAND
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  RENTED
  INACTIVE
}

enum TransactionType {
  SALE
  RENT
}

enum Role {
  ADMIN
  CORRETOR
}

model User {
  id                 String   @id @default(uuid())
  name               String?
  email              String   @unique
  passwordHash       String
  role               Role     @default(CORRETOR)
  /// Corretores desativados não conseguem entrar; imóveis e leads continuam vinculados.
  active             Boolean  @default(true)
  /// WhatsApp do corretor.
  phone              String?
  /// Foto de perfil (caminho em /uploads/corretores/).
  photo              String?
  /// Registro no CRECI (ex.: "12345-F/SP").
  creci              String?
  /// Obriga a troca da senha provisória no próximo acesso.
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  assignedLeads      Lead[]

  @@index([email])
}

model Property {
  id              String          @id @default(uuid())
  /// Código numérico curto e sequencial exibido ao cliente (ex.: 1001), fácil de memorizar.
  code            Int             @unique @default(autoincrement())
  title           String
  description     String          @db.Text
  price           Decimal         @db.Decimal(12, 2)
  type            PropertyType
  transactionType TransactionType
  bedrooms        Int
  bathrooms       Int
  area            Float
  city            String
  neighborhood    String
  address         String
  featured        Boolean         @default(false)
  status          PropertyStatus  @default(AVAILABLE)
  /// Valor mensal do condomínio.
  condoFee        Decimal?        @db.Decimal(12, 2)
  /// Valor anual do IPTU.
  iptu            Decimal?        @db.Decimal(12, 2)
  parkingSpaces   Int             @default(0)
  furnished       Boolean         @default(false)
  petFriendly     Boolean         @default(false)
  /// Chaves de lib/amenities.ts (ex.: "pool", "gym").
  amenities       String[]        @default([])
  /// Visualizações da página pública (visitantes não logados).
  viewCount       Int             @default(0)
  images          String[]
  /// Localização no mapa (módulo "mapa"). Nulo até ser geocodificado ou informado manualmente.
  latitude        Float?
  longitude       Float?
  geocodedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  leads           Lead[]

  @@index([city])
  @@index([type])
  @@index([transactionType])
  @@index([featured])
  @@index([status])
}

/// Módulos adicionais contratados por esta instalação (ver docs/modulos.md). Módulos
/// essenciais não têm linha aqui — estão sempre ligados. Alterado só pela Chrodar (v1).
model ModuleFlag {
  id        String   @id @default(uuid())
  /// Identificador estável do módulo (ver lib/modules/registry.ts).
  moduleId  String   @unique
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/// Configuração do simulador de financiamento (módulo "financiamento"). Registro único por
/// instalação — não há multi-tenant neste sistema (ver docs/modulos.md, seção 2.1).
model FinancingSettings {
  id                String   @id @default("default")
  /// Taxa de juros sugerida, em % ao ano.
  defaultRateYearly Decimal  @db.Decimal(5, 2)
  /// Entrada mínima sugerida, em %.
  minDownPaymentPct Decimal  @db.Decimal(5, 2)
  maxMonths         Int      @default(420)
  updatedAt         DateTime @updatedAt
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  LOST
}

/// Contato de um cliente interessado em um imóvel.
model Lead {
  id           String     @id @default(uuid())
  /// Opcional para o lead não se perder se o imóvel for excluído.
  propertyId   String?
  property     Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  name         String
  email        String
  phone        String
  message      String?    @db.Text
  status       LeadStatus @default(NEW)
  assignedToId String?
  assignedTo   User?      @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([propertyId])
  @@index([assignedToId])
}
